# 生产环境配置模板 —— 复制为 deploy/.env.production 并填入真实值
# ⚠️ deploy/.env.production 含真实密钥,已被 .gitignore 忽略,严禁提交入库
# (2026-08-30 健康检查:该文件曾因入库且仓库公开导致密钥泄露,务必轮换后再用)

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=kaoyandaily
DB_PASSWORD=your_strong_db_password_here
DB_NAME=kaoyandaily

# 服务端口
SERVER_PORT=3001

# 会话(认证)
# 随机串,可用 openssl rand -hex 32 生成;泄露后必须轮换(会使全部会话失效)
SESSION_SECRET=your_session_secret_here
# 生产走 HTTPS 置 true(nginx 反代 + trust proxy 1)
SESSION_COOKIE_SECURE=true
