# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=kaoyandaily

# 测试数据库
TEST_DB_NAME=kaoyandaily_test

# 服务端口
SERVER_PORT=3001

# 会话（认证）
# 随机串，可用 openssl rand -hex 32 生成
SESSION_SECRET=your_session_secret_here
# 会话 Cookie 是否仅经 HTTPS 传输（本地 http 开发为 false，生产 HTTPS 置 true）
SESSION_COOKIE_SECURE=false
